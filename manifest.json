{
  "manifest_version": 3,
  "name": "Session Reset",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Clears a site's cookies after you close its last tab, and hides ads and suggested posts on your Instagram feed.",

  "permissions": [
    "storage",
    "cookies"
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram-feed-data.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram-feed.js"],
      "css": ["instagram-feed.css"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Reset"
  }
}
